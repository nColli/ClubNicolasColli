DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# Cuenta de servicio de Firebase: los valores salen del JSON que se descarga en
# Firebase Console → Configuración del proyecto → Cuentas de servicio →
# "Generar nueva clave privada" (campos project_id, client_email y private_key).
FIREBASE_PROJECT_ID=clubnicolascolli
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@clubnicolascolli.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Opcional: cada cuántos segundos se revisa si hay recordatorios push para
# enviar (por defecto 300 = 5 minutos). Para una demo, por ejemplo 10.
# AVISOS_INTERVALO_SEGUNDOS=10
